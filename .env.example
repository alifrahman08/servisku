# PostgreSQL Database URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/servisku?schema=public"

# Alternative for instant local testing without PostgreSQL:
# DATABASE_URL="file:./dev.db"

# JWT Secret for Session Cookie
JWT_SECRET="servisku-secure-random-jwt-secret-key-32-chars-long"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SMTP Email Configuration (Optional / Development Mode logs to console)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="2525"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ServisKu <noreply@servisku.com>"
